{
  "name": "nexusflow",
  "version": "1.0.0",
  "description": "NexusFlow",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "build": {
    "appId": "com.nexusflow.app",
    "productName": "NexusFlow",
    "asarUnpack": [
      "node_modules/ffmpeg-static/**/*",
      "node_modules/playwright-core/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "portable",
      "icon": "icon.png"
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "playwright": "^1.61.1"
  },
  "devDependencies": {
    "electron": "^43.7.7",
    "electron-builder": "^26.15.3"
  }
}
